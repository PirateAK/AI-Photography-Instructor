# ---- Photo Coach engine ----
# auto   -> heuristic coach unless a key is configured (env or in-app Setup page)
# mock   -> always the deterministic heuristic coach (no API calls, no cost)
# openai -> OpenAI vision engine
# gemini -> Google Gemini vision engine
PHOTO_COACH_PROVIDER=auto

# Preferred: configure the engine from the app's Setup page (⚙ in the header) —
# it stores provider + key + model in runtime_settings.json (gitignored).
# These env vars are the fallback for headless setups.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=

# Max upload size in MB (server rejects larger files with a friendly 413)
MAX_UPLOAD_MB=20
